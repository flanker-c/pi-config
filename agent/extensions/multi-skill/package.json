{
  "name": "pi-local-multi-skill",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package"
  ],
  "files": [
    "*.ts",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "^22.0.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check": "tsc --noEmit",
    "check:package": "node scripts/check-package.mjs",
    "verify": "npm run check && npm test && npm run check:package"
  }
}
